{
  "appId": "it.mentalclass.mentalclass",
  "appName": "MentalClass",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "backgroundColor": "#08444C",
  "ios": {
    "contentInset": "automatic"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#08444C",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#C2E83E"
    }
  },
  "packageClassList": [
    "SplashScreenPlugin",
    "PushNotificationsPlugin",
    "LocalNotificationsPlugin",
    "WidgetBridgePlugin"
  ]
}