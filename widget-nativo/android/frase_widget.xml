<?xml version="1.0" encoding="utf-8"?>
<!--
  MentalClass · Layout del widget Android
  Va in: android/app/src/main/res/layout/frase_widget.xml
  Lo sfondo brand è definito in: res/drawable/widget_sfondo.xml
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_sfondo"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MENTALCLASS"
        android:textColor="#C2E83E"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.15" />

    <TextView
        android:id="@+id/widget_frase"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:text="La disciplina è la forma più alta di libertà."
        android:textColor="#F1EDE2"
        android:textSize="15sp"
        android:maxLines="4"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_autore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="#C2E83E"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
