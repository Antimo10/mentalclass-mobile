{
  "appId": "it.mentalclass.mentalclass",
  "appName": "MentalClass",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "backgroundColor": "#052c31",
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#052c31"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#052c31",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#C2E83E"
    }
  }
}
